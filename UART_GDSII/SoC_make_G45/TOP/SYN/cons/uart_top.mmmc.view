# UART standalone MMMC: SS setup, FF setup comparison, FF hold view.
# Library paths are absolute so the file can be read from SYN directly.
create_library_set -name UART_FF_LIBS -timing [list \
  /GPDK045/digital/gsclib045_all_v4.4/gsclib045/timing/fast_vdd1v0_basicCells.lib \
  /GPDK045/digital/gsclib045_all_v4.4/gsclib045/timing/fast_vdd1v0_multibitsDFF.lib \
  /GPDK045/digital/giolib045_v3.5/timing/pads_FF_s1vg.lib]

create_library_set -name UART_SS_LIBS -timing [list \
  /GPDK045/digital/gsclib045_all_v4.4/gsclib045/timing/slow_vdd1v0_basicCells.lib \
  /GPDK045/digital/gsclib045_all_v4.4/gsclib045/timing/slow_vdd1v0_multibitsDFF.lib \
  /GPDK045/digital/giolib045_v3.5/timing/pads_SS_s1vg.lib]

create_opcond -name UART_FF_OPCOND -process 1.0 -voltage 1.1 -temperature 0
create_opcond -name UART_SS_OPCOND -process 1.0 -voltage 0.9 -temperature 125
create_timing_condition -name UART_FF_TIMING -opcond UART_FF_OPCOND -library_sets {UART_FF_LIBS}
create_timing_condition -name UART_SS_TIMING -opcond UART_SS_OPCOND -library_sets {UART_SS_LIBS}

# Same estimated RC for both views. Extracted RC must be checked after route.
create_rc_corner -name UART_RC -qrc_tech /GPDK045/digital/gsclib045_all_v4.4/gsclib045_tech/qrc/qx/gpdk045.tch
create_delay_corner -name UART_FF_CORNER \
  -early_timing_condition UART_FF_TIMING -late_timing_condition UART_FF_TIMING \
  -early_rc_corner UART_RC -late_rc_corner UART_RC
create_delay_corner -name UART_SS_CORNER \
  -early_timing_condition UART_SS_TIMING -late_timing_condition UART_SS_TIMING \
  -early_rc_corner UART_RC -late_rc_corner UART_RC

create_constraint_mode -name UART_FUNC -sdc_files [list ./cons/uart_top_mmmc.sdc]
create_analysis_view -name UART_FF_BEST -constraint_mode UART_FUNC -delay_corner UART_FF_CORNER
create_analysis_view -name UART_SS_WORST -constraint_mode UART_FUNC -delay_corner UART_SS_CORNER
set_analysis_view -setup {UART_SS_WORST UART_FF_BEST} -hold {UART_FF_BEST}
